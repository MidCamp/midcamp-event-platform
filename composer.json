{
    "name": "midcamp/midcamp-ep",
    "description": "MidCamp 2026 and onward! Based on the Event Platform.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.midcamp.org",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "amazeeio/drupal_integrations": "^0.5.0",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/captcha": "^2.0.7",
        "drupal/coffee": "^2",
        "drupal/config_normalizer": "^1.0@beta",
        "drupal/config_split": "^2.0",
        "drupal/core": "^11.2",
        "drupal/core-composer-scaffold": "^11.2",
        "drupal/core-project-message": "^11.2",
        "drupal/core-recipe-unpack": "^11.2",
        "drupal/core-recommended": "^11.2",
        "drupal/dashboard": "^2",
        "drupal/easy_breadcrumb": "^2.0.9",
        "drupal/editoria11y": "^2.2",
        "drupal/element_class_formatter": "^2.1",
        "drupal/event_horizon": "^1.0@rc",
        "drupal/focal_point": "^2",
        "drupal/friendly_captcha_challenge": "^0.9",
        "drupal/friendlycaptcha": "^1.1",
        "drupal/gin": "^5",
        "drupal/google_tag": "^2.0",
        "drupal/honeypot": "^2.1",
        "drupal/keysave": "^1.1",
        "drupal/lagoon_logs": "^3.0",
        "drupal/masquerade": "^2.0",
        "drupal/navigation_extra_tools": "^1.2",
        "drupal/pathauto": "^1.13",
        "drupal/redirect": "^1.10",
        "drupal/redirect_metrics": "^2.0",
        "drupal/sam": "^1.2",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/svg_image": "^3.1",
        "drupal/tagify": "^1.2",
        "drupal/token": "^1.15",
        "drupal/turnstile": "^1.1",
        "drupal/views_flag_refresh": "^1.0",
        "drupal/visitors": "^2.32",
        "drush/drush": "^13.6",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "patches": {
            "drupal/event_horizon": {
              "Event Horizon's secondary menus inoperable when authenticated & BigPipe present": "patches/event_horizon-issue-3568876.patch"  
            }
        },
        "merge-plugin": {
          "include": [
            "web/modules/contrib/webform/composer.libraries.json"
          ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/default/all.settings.php": "assets/all.settings.php"
            },
            "allowed-packages": [
                "amazeeio/drupal_integrations"
            ]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
